{
  "name": "gekichin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ui": "vite --host 127.0.0.1 --config vite.ui.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test --config=playwright.ui.config.ts",
    "test:browser:legacy": "playwright test --config=playwright.config.ts --grep-invert='ui-only\\.spec\\.ts'"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/three": "0.183.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
